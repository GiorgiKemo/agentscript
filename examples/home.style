  center
  round 999px
  padding 8px 14px
}

select badge_one_text {
  text size 14px
  text color #19613e
  bold
  center text
}

select task_one {
  grow
  text size 18px
  text color #10281e
  bold
}

select item_one_actions {
  line up
  space 10px
  push right
}

select done_one {
  fill #1e6b43
  text color white
  padding 12px 16px
  round 14px
}

select remove_one {
  fill #efe5d5
  text color #6d5a44
