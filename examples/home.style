select top {
  line up
  align center
  space 16px
}

select brand {
  text size 26px
  text color #143224
}

select nav_note {
  push right
  text color #56705f
}

select board {
  stack
  space 24px
}

select composer {
  fill #f6f1e6
  shadow medium
}

select kicker {
  text color #5d7564
  bold
}

select title {
  text size 56px
  text color #10281e
}

select intro {
  text color #4c6455
}

select input_bar {
  line up
  align center
  space 14px
}

select draft_input {
  fill white
  text color #173729
  size 420px 54px
  padding 14px 18px
  round 16px
}

select add_task {
  fill #1e6b43
  text color white
  padding 14px 22px
  round 16px
}

select clear_all {
  fill #e5ecdf
  text color #173729
  padding 14px 22px
  round 16px
}

select summary {
  line up
  align stretch
  space 16px
}

select total_card {
  fill white
  shadow soft
  stack
  space 4px
  round 22px
  grow
}

select done_card {
  fill #12291f
  shadow soft
  stack
  space 4px
  round 22px
  grow
}

select status_box {
  fill #e6f0e3
  shadow soft
  center
  round 22px
  grow
}

select total_label {
  text size 14px
  text color #5d7564
  bold
}

select total_value {
  text size 36px
  text color #10281e
  bold
}

select done_label {
  text size 14px
  text color #9ec0aa
  bold
}

select done_value {
  text size 36px
  text color white
  bold
}

select board_status {
  text size 18px
  text color #204c35
  bold
  center text
}

select task_list {
  fill #fcfaf4
  shadow medium
  stack
  space 18px
}

select list_head {
  line up
  align end
  space 14px
}

select list_title {
  text size 34px
  text color #10281e
}

select list_note {
  push right
  text color #5d7564
}

select empty_box {
  fill #efe5d5
  round 20px
  center
}

select empty_state {
  text size 18px
  text color #6d5a44
  center text
}

select slots {
  stack
  space 14px
}

